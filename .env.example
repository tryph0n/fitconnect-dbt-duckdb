# DuckDB / dbt
DUCKDB_PATH=data/fitconnect.duckdb
DOCS_PORT=8080
ANALYTICS_SCHEMA=analytics
DBT_THREADS=4

# PostgreSQL (Python code / psycopg)
# PG_PASSWORD and POSTGRES_PASSWORD must match
PG_USER=postgres
PG_PASSWORD=changeme
PG_HOST=postgres
PG_PORT=5432
PG_DB=fitconnect

# PostgreSQL (Docker image)
# POSTGRES_PASSWORD is required by postgres:16 (cannot be empty)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fitconnect

# S3 (local moto by default)
# The "s3" Compose service accepts any keys. The loader creates the bucket.
# For real AWS S3: leave S3_ENDPOINT_URL empty, set your own access keys and
# region, and use a bucket name of your own (bucket names are global on AWS).
S3_ENDPOINT_URL=http://s3:5000
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-west-3
S3_BUCKET=fitconnect-raw
S3_PREFIX=fitconnect/
