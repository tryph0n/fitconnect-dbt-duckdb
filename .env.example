# DuckDB / dbt
DUCKDB_PATH=data/fitconnect.duckdb
DOCS_PORT=8080
ANALYTICS_SCHEMA=analytics
DBT_THREADS=4

# PostgreSQL (Python code / psycopg)
# PG_PASSWORD and POSTGRES_PASSWORD must match
PG_USER=postgres
PG_PASSWORD=changeme
PG_HOST=postgres
PG_PORT=5432
PG_DB=fitconnect

# PostgreSQL (Docker image)
# POSTGRES_PASSWORD is required by postgres:16 (cannot be empty)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fitconnect

# AWS S3 (required — fill with your credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
S3_BUCKET=
S3_PREFIX=fitconnect/
